# Copiez ce fichier en `.env` et remplissez les valeurs. Ne le versionnez pas.
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email de vérification (laisser vide = lien affiché dans la console du serveur)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Modèle Hugging Face et réglages de détection
DEEPFAKE_MODEL=prithivMLmods/Deep-Fake-Detector-Model
FAKE_THRESHOLD=0.5
MAX_VIDEO_FRAMES=16
USE_FACE_CROP=true

# 1 uniquement en développement local
FLASK_DEBUG=0
